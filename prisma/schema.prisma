generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite has no native enum support in Prisma, so all "enum-like"
// fields below are plain String columns. Allowed values are documented
// as constants in src/lib/constants.ts — treat that file as the source
// of truth and validate against it at the application layer.

// ─────────────────────────────────────────────────────────────
// 사용자 / 인증
// ─────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  name            String
  phone           String?
  discordId       String?  @unique
  isSeedData      Boolean  @default(false)
  points          Int      @default(0)
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | WITHDRAWN
  suspendedReason String?
  adminMemo       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 출석체크 이벤트 - 마지막 출석일과 연속 출석 일수
  lastCheckInAt  DateTime?
  checkInStreak  Int       @default(0)

  // 친구 초대 이벤트
  referralCode       String?   @unique // 이 유저가 남에게 공유하는 내 초대코드 (최초 /초대코드 조회 시 생성)
  referredByUserId   String? // 나를 초대한 사람 (한 번 등록하면 변경 불가)
  referrer           User?     @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referrals          User[]    @relation("UserReferrals")
  referralRewardedAt DateTime? // 초대 보상(첫 구매 시 지급)을 이미 지급했는지

  // 누적구매 리더보드에서 내 이름 대신 "익명"으로 표시할지
  leaderboardAnonymous Boolean @default(false)

  orders         Order[]
  pointTx        PointTransaction[]
  topUpRequests  PointTopUpRequest[]
  couponUsages   CouponUsage[]
  userCoupons    UserCoupon[]
  reviews        Review[]
  inquiries      Inquiry[]
  reports        Report[]        @relation("ReporterUser")
  notifications  Notification[]
  refundRequests   RefundRequest[]
  exchangeRequests ExchangeRequest[]
  sessions         UserSession[]
  cartItems        CartItem[]
  restockSubscriptions RestockSubscription[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// 관리자
// ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  loginId      String   @unique
  passwordHash String
  name         String
  role         String   @default("STAFF") // SUPER | MANAGER | STAFF
  status       String   @default("ACTIVE") // ACTIVE | DISABLED
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  discordId    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loginLogs    AdminLoginLog[]
  activityLogs AdminActivityLog[]
  sessions     AdminSession[]
}

// 근무 상태(출근/퇴근/일시중지) 패널용. 웹 관리자 계정(AdminUser)과는 별개로, 디스코드
// 서버에서 관리자 역할(DISCORD_ADMIN_ROLE_ID)을 가진 사람이면 누구나 대상이 된다 -
// 웹 로그인 계정이 있는지와 무관하다. discordId 자체를 키로 쓴다.
model AdminDutyStatus {
  discordId String   @id
  name      String // 패널 표시용 - 상태가 바뀔 때마다 그 시점의 서버 닉네임으로 갱신
  status    String   @default("OFF_DUTY") // ON_DUTY | OFF_DUTY | PAUSED
  updatedAt DateTime @updatedAt
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model AdminLoginLog {
  id        String     @id @default(cuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  loginId   String
  ip        String?
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime   @default(now())
}

model AdminActivityLog {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// 상품 등급 (랜덤 티어) / 재고(계정)
// ─────────────────────────────────────────────────────────────

model Tier {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  price                Int
  description          String?
  status               String   @default("ON_SALE") // ON_SALE | HIDDEN | SOLD_OUT
  purchaseLimitPerUser Int?
  sortOrder            Int      @default(0)
  // 구매하기 패널에서 카테고리별로 나눠 보여주기 위한 분류. 비어있으면 "기타"로 묶인다.
  category             String?
  // 이 등급 계정 1개를 확보하는 데 든 원가. 관리자 대시보드에서 순이익/적자 계산에 쓰인다.
  costPrice            Int?
  // "할인 모드" 켜져 있는 동안 "한섭 " 등급의 원래(할인 전) 가격을 잠깐 보관해둔다 -
  // 꺼지면 이 값으로 되돌린다. 할인 모드가 꺼져 있을 땐 항상 null.
  originalPrice        Int?
  // 켜져있고 ShopSetting.buyOneGetOneEventEnabled도 켜져있으면, 이 등급을 구매할 때마다
  // 같은 가격으로 재고가 있는 만큼 하나 더 지급한다 ("1+1" 이벤트).
  buyOneGetOneEnabled  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  artworks             Artwork[]
  orders               Order[]
  cartItems            CartItem[]
  raffleEvents         RaffleEvent[]
  flashSales           FlashSale[]
  restockSubscriptions RestockSubscription[]
}

model Artwork {
  id              String    @id @default(cuid())
  code            String    @unique
  tierId          String
  tier            Tier      @relation(fields: [tierId], references: [id])
  title           String
  isSeedData      Boolean   @default(false)
  // 실제 판매 콘텐츠. 업로드된 파일 키(uploads/ 하위 경로) 또는 일괄 등록 시 입력한
  // 링크/텍스트가 그대로 들어간다 - isUploadKey()로 둘을 구분한다.
  fileKey         String
  previewKey      String?
  status          String    @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD | HIDDEN
  reservedOrderId String?   @unique
  reservedAt      DateTime?
  soldAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  order Order? @relation("ArtworkOrder", fields: [reservedOrderId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// 주문 / 결제(포인트) / 환불
// ─────────────────────────────────────────────────────────────

model Order {
  id                   String    @id @default(cuid())
  orderNo              String    @unique
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id])
  guestEmail           String?
  guestPhone           String?
  tierId               String
  tier                 Tier      @relation(fields: [tierId], references: [id])
  priceAtPurchase      Int
  couponId             String?
  coupon               Coupon?   @relation(fields: [couponId], references: [id])
  discountAmount       Int       @default(0)
  pointsUsed           Int       @default(0)
  finalAmount          Int
  status               String    @default("PENDING_PAYMENT")
  // PENDING_PAYMENT | RESERVED | PAID | COMPLETED | CANCELLED | EXPIRED | REFUND_REQUESTED | REFUNDED
  reservationExpiresAt DateTime?
  paidAt               DateTime?
  drawnAt              DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  firstDownloadedAt    DateTime?
  // "1+1" 이벤트로 공짜로 지급된 보너스 주문 표시 (finalAmount는 항상 0이라 매출 집계에
  // 영향 없음). bonusForOrderId는 원래 결제한 주문을 가리킨다.
  isBonusOrder         Boolean   @default(false)
  bonusForOrderId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  artwork        Artwork?           @relation("ArtworkOrder")
  couponUsage    CouponUsage?
  pointTx        PointTransaction[]
  review         Review?
  refundRequest  RefundRequest?
  exchangeRequest ExchangeRequest?
  notifications  Notification[]
  downloadLogs   DownloadLog[]
  bonusForOrder  Order?             @relation("OrderBonus", fields: [bonusForOrderId], references: [id])
  bonusOrders    Order[]            @relation("OrderBonus")
}

model DownloadLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

model PointTransaction {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String // CHARGE | USE | REFUND | ADMIN_ADJUST | EXPIRE
  amount         Int
  balanceAfter   Int
  relatedOrderId String?
  relatedOrder   Order?   @relation(fields: [relatedOrderId], references: [id])
  relatedTopUpId String?
  memo           String?
  createdAt      DateTime @default(now())
}

model PointTopUpRequest {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  amount             Int
  depositorName      String
  bankName           String?
  status             String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  adminNote          String?
  confirmedByAdminId String?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())
}

model RefundRequest {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id])
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  reason             String
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED
  adminNote          String?
  refundAmount       Int?
  processedByAdminId String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  // 방치된 요청 알림을 마지막으로 보낸 시각 (같은 건으로 반복 스팸하지 않기 위해 기록)
  remindedAt         DateTime?
}

// 계정 교환(재추첨) 요청. 구매자가 사유 + 증빙 파일과 함께 신청하면, 관리자 승인이
// 있어야만 실제로 다른 재고로 교환된다 (구매자가 직접 재추첨할 수는 없다).
model ExchangeRequest {
  id                 String    @id @default(cuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id])
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  reason             String
  proofFileKey       String
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote          String?
  processedByAdminId String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  // 방치된 요청 알림을 마지막으로 보낸 시각 (같은 건으로 반복 스팸하지 않기 위해 기록)
  remindedAt         DateTime?
}

// ─────────────────────────────────────────────────────────────
// 파트너 (서버 간 상호 홍보)
// ─────────────────────────────────────────────────────────────

// 신청자는 디스코드 사용자일 뿐 꼭 자비샵 회원(User)일 필요는 없어서 User와 관계를 맺지 않는다.
model Partner {
  id                 String    @id @default(cuid())
  discordUserId      String    @unique
  discordTag         String
  name               String // 파트너 서버/채널 이름
  emoji              String? // 채널명에 붙일 이모지 (비워두면 기본 이모지 사용)
  description        String?
  webhookUrl         String? // 매일 1회 우리 쪽 홍보 문구를 받을(자비샵 -> 파트너 서버) 디스코드 웹훅 URL
  promoMessage       String? // 매일 1회 이 파트너의 채널(channelId)에 게시할 파트너 자신의 홍보 문구 (파트너 -> 자비샵)
  status             String    @default("PENDING") // PENDING | APPROVED | REJECTED
  channelId          String? // 승인 시 파트너 카테고리 밑에 자동 생성된 채널
  adminNote          String?
  processedByAdminId String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// 쿠폰
// ─────────────────────────────────────────────────────────────

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  discountType      String // AMOUNT | RATE
  discountValue     Int
  minOrderAmount    Int      @default(0)
  maxDiscountAmount Int?
  validFrom         DateTime
  validTo           DateTime
  usageLimitTotal   Int?
  usageLimitPerUser Int      @default(1)
  applicableTierIds String? // JSON array of Tier ids, null = 전체 적용
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  usages      CouponUsage[]
  userCoupons UserCoupon[]
  orders      Order[]
}

model UserCoupon {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  couponId String
  coupon   Coupon    @relation(fields: [couponId], references: [id])
  issuedAt DateTime  @default(now())
  usedAt   DateTime?

  @@unique([userId, couponId])
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// 리뷰 / 문의 / 신고 / 알림
// ─────────────────────────────────────────────────────────────

model Review {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  orderId          String   @unique
  order            Order    @relation(fields: [orderId], references: [id])
  rating           Int
  content          String
  images           String? // JSON array of file keys
  status           String   @default("VISIBLE") // VISIBLE | HIDDEN
  purchaseVerified Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reports Report[] @relation("ReportedReview")
}

model Inquiry {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  title             String
  content           String
  images            String? // JSON array of file keys
  status            String    @default("WAITING") // WAITING | PROCESSING | ANSWERED | CLOSED
  answer            String?
  answeredByAdminId String?
  answeredAt        DateTime?
  adminNote         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Report {
  id                 String    @id @default(cuid())
  reporterId         String
  reporter           User      @relation("ReporterUser", fields: [reporterId], references: [id])
  targetType         String // PRODUCT | REVIEW | USER | OTHER
  targetId           String
  reviewTarget       Review?   @relation("ReportedReview", fields: [reviewTargetId], references: [id])
  reviewTargetId     String?
  reason             String
  detail             String?
  status             String    @default("PENDING") // PENDING | PROCESSING | RESOLVED | REJECTED
  processedByAdminId String?
  processResult      String?
  createdAt          DateTime  @default(now())
  processedAt        DateTime?
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId    String
  tier      Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, tierId])
}

model ShopSetting {
  id                         String  @id @default("singleton")
  shopName                   String  @default("자비샵")
  // 인증 패널("인증하기" 버튼)을 눌렀을 때 바로 지급할 역할. 예전엔 자비샵 본인
  // 서버의 외부 인증 사이트 URL+역할 ID가 하드코딩되어 있었는데, 테넌트 샵마다
  // 다를 수밖에 없어서 샵별로 설정하게 바꿨다.
  verifyRoleId               String?
  bankName                   String  @default("")
  bankAccountNumber          String  @default("")
  bankAccountHolder          String  @default("")
  // 입금알림 안드로이드 앱이 보내는 웹훅의 서명 검증용 비밀키. 샵마다 다른 값을 써야
  // 한 샵의 비밀키가 새도 다른 샵 웹훅을 위조할 수 없다 (자판기 판매로 생긴 테넌트
  // 샵은 생성 시점에 자동으로 발급됨 - src/lib/provisionShop.ts).
  bankWebhookSecret          String?
  refundAllowedAfterDownload Boolean @default(false)
  noticeMessage              String?

  // 디스코드 연동 - 구매 로그 채널 / 실시간 통계 음성채널
  discordPurchaseLogChannelId String?
  discordMemberCountChannelId String?
  discordBuyerCountChannelId  String?
  // 이 채널에 올라오는 메시지는 5초 뒤 자동 삭제된다 (예: 문의/상담용 임시 채팅 채널).
  discordAutoDeleteChannelId  String?

  // 디스코드 연동 - 누적 구매금액 등급별 자동 지급 역할 (역할 ID는 관리자가 Discord에서 직접 만든 뒤 등록)
  discordRoleTier150k String? // 150,000원 이상 - 10% 할인
  discordRoleTier100k String? // 100,000원 이상 - 8% 할인
  discordRoleTier50k  String? // 50,000원 이상 - 5% 할인
  discordRoleTier10k  String? // 10,000원 이상 - 할인 없음, 표시 전용
  discordRoleBuyer    String? // 1원 이상 구매한 모든 회원

  // 파트너 기능 - 승인 시 이 카테고리 밑에 채널을 만들고 이 역할을 지급한다.
  partnerCategoryId    String?
  partnerRoleId        String?
  // 매일 1회 승인된 모든 파트너의 웹훅으로 보낼 문구 (관리자가 설정)
  partnerDailyMessage  String?
  // 마지막으로 일일 파트너 웹훅 발송을 실행한 시각 - 봇이 재시작돼도 하루 1회를 지키기 위해 저장해둔다.
  partnerLastBroadcast DateTime?

  // 판매자(제3자 입점) 기능 - 승인 시 이 카테고리 밑에 채널을 만들고 이 역할을 지급한다.
  // 구매 문의 티켓 채널은 별도로 sellerTicketCategoryId 밑에 만든다 (판매자 쇼룸 카테고리와
  // 분리해야 다른 판매자/구매자 거래 내역이 서로 안 보인다). 판매자 본인만 보이는 비공개
  // "관리 패널" 채널은 별도 카테고리를 안 만들고 sellerCategoryId(쇼룸 카테고리) 밑에
  // 같이 둔다 - 채널 자체의 권한 overwrite가 카테고리 상속보다 항상 우선하므로, 같은
  // 카테고리 안에 있어도 그 채널만 비공개로 유지된다.
  sellerCategoryId       String?
  sellerTicketCategoryId String?
  sellerRoleId           String?
  // 월 이용료(원) / 첫 가입 시 무료로 쓸 수 있는 기간(일) - 관리자가 /설정수정에서 조정 가능.
  sellerMonthlyPrice   Int @default(1000)
  sellerFreeTrialDays  Int @default(30)

  // 매일 1회 오늘 매출/이용자 등 통계를 자동으로 게시할 공지 채널
  announcementChannelId String?
  // 마지막으로 일일 통계 공지를 게시한 시각 - 봇이 재시작돼도 하루 1회를 지키기 위해 저장해둔다.
  dailyStatsLastPosted   DateTime?

  // 일반 회원도 볼 수 있는 공개 통계 패널 (오늘/누적 매출 등). 몇 분마다 자동으로 메시지를
  // 갱신한다. 최고관리자(AdminUser.role === SUPER) 계정의 구매는 매출 집계에서 자동 제외된다.
  publicStatsChannelId String?
  publicStatsMessageId String?

  // 관리자 근무 상태(출근/퇴근/일시중지) 현황판. presenceUpdate로 상태가 바뀔 때마다
  // 이 메시지를 편집해서 갱신한다.
  adminDutyChannelId String?
  adminDutyMessageId String?

  // 관리자가 직접 출근/퇴근/일시중지를 누르는 버튼 패널. 메시지는 고정이고 버튼만 쓴다.
  adminDutyControlChannelId String?
  adminDutyControlMessageId String?

  // 켜두면 구매가 완료될 때마다 5% 확률로 10% 할인 쿠폰을 구매자에게 자동 지급한다.
  purchaseCouponDropEnabled Boolean @default(false)

  // 켜면 "한섭 " 등급들의 가격을 전부 대응되는 일반 등급과 같게 낮추고(프리미엄 해제),
  // 끄면 켜기 전 가격(Tier.originalPrice)으로 되돌린다.
  discountModeEnabled Boolean @default(false)

  // 이벤트 기능 개별 on/off
  checkInEventEnabled  Boolean @default(false) // 출석체크
  flashSaleEventEnabled Boolean @default(false) // 타임세일 (개별 세일은 FlashSale로 관리, 이건 전체 스위치)
  referralEventEnabled Boolean @default(false) // 친구 초대
  gachaEventEnabled    Boolean @default(false) // 룰렛/뽑기
  gachaCostPoints      Int     @default(100) // 룰렛 1회 비용(포인트)
  // 켜져있으면, Tier.buyOneGetOneEnabled가 켜진 등급을 구매할 때마다 같은 가격으로
  // 재고가 있는 만큼 하나 더 지급한다 ("1+1" 이벤트). 등급별 on/off는 /등급수정에서.
  buyOneGetOneEventEnabled Boolean @default(false)

  // 마지막으로 홍보직원 정산 보고 DM을 보낸 시각 - 매주 금요일 1회만 보내기 위해 저장해둔다.
  promoReportLastSentAt DateTime?
  // 홍보직원으로 등록되면 자동으로 지급하고, 그만두면 회수하는 역할.
  promoStaffRoleId      String?

  // 안티스팸(메시지 도배/멘션 폭탄/초대 링크/파일 도배 등) 자동 감지 - src/bot/antiSpam.ts.
  antiSpamEnabled              Boolean @default(false)
  antiSpamLogChannelId         String? // 제재 로그 + "오탐 해제" 버튼이 올라오는 채널
  antiSpamWhitelistRoleId      String? // 이 역할을 가진 멤버는 감지 대상에서 제외 (관리자는 항상 자동 제외)
  antiSpamFloodCount           Int     @default(6) // antiSpamFloodWindowSec 안에 이 개수 이상 메시지를 보내면 도배로 간주
  antiSpamFloodWindowSec       Int     @default(5)
  antiSpamMentionLimit         Int     @default(5) // 메시지 1개에 이 개수 이상 멘션(유저+역할)이 있으면 멘션 폭탄으로 간주
  antiSpamEmergencyThreshold   Int     @default(10) // antiSpamEmergencyWindowSec 안에 서버 전체 위반이 이 횟수를 넘으면 긴급모드 발동
  antiSpamEmergencyWindowSec   Int     @default(60)
  antiSpamEmergencyDurationMin Int     @default(10) // 긴급모드 동안 전체 채널에 슬로우모드를 적용할 시간(분)

  // 사진/영상 첨부 자체를 아예 금지 (도배 여부와 무관하게 1개만 올려도 즉시 삭제).
  antiSpamBlockImages Boolean @default(false)
  antiSpamBlockVideos Boolean @default(false)
  // 위 금지 규칙의 예외 - 이 카테고리 밑 채널에서는 사진/영상을 올려도 삭제하지 않는다
  // (예: 구매 문의/티켓/관리자 카테고리는 스크린샷 공유가 필요함). 쉼표로 구분한 카테고리 ID 목록.
  antiSpamMediaExemptCategoryIds String?

  // 부계정(알트) 의심 감지 - 메시지가 아니라 서버 입장(GuildMemberAdd) 시점에 본다.
  // 계정 생성일이 이 일수보다 어리면 "너무 새 계정"으로 의심한다 (0=비활성).
  antiSpamAltAccountMinAgeDays Int     @default(0)
  // 켜면 새로 들어온 사람의 닉네임/유저명이 기존 멤버와 너무 비슷한지 비교한다
  // (예: "eme"와 "eme1" - 숫자/특수문자만 다르거나 한두 글자 차이).
  antiSpamSimilarNameCheck     Boolean @default(false)
}

// 어드민 웹 패널에서 지정하는 "홍보직원" - 디스코드 서버에 영구 초대 링크를 발급받아
// 홍보하고, 그 링크로 들어온 인원수만큼 정산받는다. 실제 지급(계좌 송금)은 관리자가
// 수동으로 하고, 이 모델은 "얼마를 줘야 하는지" 계산용 데이터만 들고 있다.
model PromoStaff {
  id                String    @id @default(cuid())
  discordUserId     String    @unique
  name              String // 등록 시점 디스코드 닉네임/태그 (패널 표시용 - 실시간 동기화 안 됨)
  inviteCode        String    @unique // 디스코드 영구 초대 코드 (discord.gg/{code})
  inviteChannelId   String? // 초대 링크가 걸린 채널
  bankName          String?
  bankAccountNumber String?
  accountHolder     String?
  status            String    @default("ACTIVE") // ACTIVE | REMOVED
  createdAt         DateTime  @default(now())
  removedAt         DateTime?

  invites PromoInvite[]
}

// 홍보직원의 영구 초대 링크로 서버에 들어온 사람 1명당 1행. 재입장해도 중복 집계하지 않는다.
model PromoInvite {
  id            String   @id @default(cuid())
  promoStaffId  String
  promoStaff    PromoStaff @relation(fields: [promoStaffId], references: [id], onDelete: Cascade)
  discordUserId String   @unique
  joinedAt      DateTime @default(now())
}

// "인증하기" 패널(디스코드 OAuth + ALTCHA)을 통과할 때마다 1행씩 쌓인다. 같은 IP로 여러
// 계정이 인증한 경우를 admin 패널에서 걸러낼 수 있도록 매번 기록을 남긴다(최신화 안 함).
model VerificationLog {
  id              String   @id @default(cuid())
  discordUserId   String
  discordUsername String
  ip              String?
  userAgent       String?
  verifiedAt      DateTime @default(now())
}

// ── 서버 백업/복원/다른 서버로 복제 ──────────────────────────────
// 어드민 웹 패널에서 "백업 생성"을 누르면 이 행이 PENDING으로 생성되고, 봇 프로세스가
// 주기적으로 폴링하며 실제 디스코드 API 작업(채널/역할/메시지/멤버 수집)을 수행한다.
// 웹 요청-응답 1회로 끝내기엔 너무 오래 걸리는 작업이라(레이트리밋 때문에 큰 서버는
// 수십 분~그 이상) 큐 방식으로 처리한다.
model ServerBackup {
  id           String    @id @default(cuid())
  guildId      String
  label        String
  status       String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  progress     String?
  error        String?
  channelCount Int       @default(0)
  roleCount    Int       @default(0)
  messageCount Int       @default(0)
  memberCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  roles       BackupRole[]
  categories  BackupCategory[]
  channels    BackupChannel[]
  members     BackupMember[]
  restoreJobs RestoreJob[]
}

model BackupRole {
  id          String       @id @default(cuid())
  backupId    String
  backup      ServerBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  originalId  String
  name        String
  color       Int
  permissions String
  position    Int
  hoist       Boolean
  mentionable Boolean
}

model BackupCategory {
  id         String       @id @default(cuid())
  backupId   String
  backup     ServerBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  originalId String
  name       String
  position   Int
  overwrites String // JSON
  channels   BackupChannel[]
}

model BackupChannel {
  id         String          @id @default(cuid())
  backupId   String
  backup     ServerBackup    @relation(fields: [backupId], references: [id], onDelete: Cascade)
  categoryId String?
  category   BackupCategory? @relation(fields: [categoryId], references: [id])
  originalId String
  name       String
  type       Int
  topic      String?
  position   Int
  nsfw       Boolean @default(false)
  overwrites String // JSON

  messages BackupMessage[]
}

model BackupMessage {
  id              String        @id @default(cuid())
  channelId       String
  channel         BackupChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  originalId      String
  authorId        String
  authorName      String
  authorAvatarUrl String?
  content         String
  attachmentUrls  String? // JSON 배열
  reactions       String? // JSON [{emoji,count}] - 누가 눌렀는지는 디스코드가 안 알려줘서 개수만
  postedAt        DateTime
}

model BackupMember {
  id            String       @id @default(cuid())
  backupId      String
  backup        ServerBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  discordUserId String
  username      String
  nickname      String?
  roleIds       String // JSON 배열 - 원본 역할 id들
  joinedAt      DateTime?
}

// 특정 백업을 (같은 서버에) 복원하거나 (새 서버에) 복제하는 작업 1건.
model RestoreJob {
  id            String       @id @default(cuid())
  backupId      String
  backup        ServerBackup @relation(fields: [backupId], references: [id], onDelete: Cascade)
  targetGuildId String
  mode          String // RESTORE_SAME | CLONE_NEW
  status        String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  progress      String?
  error         String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

// 등급별 한시적 할인(타임세일). 켜져 있는 동안(startsAt~endsAt) 구매하면 discountPercent만큼
// 자동 할인되고, 쿠폰 자동적용과 비교해 더 큰 쪽 하나만 적용된다 (중복 적용 안 됨).
model FlashSale {
  id                String   @id @default(cuid())
  tierId            String
  tier              Tier     @relation(fields: [tierId], references: [id])
  discountPercent   Int
  startsAt          DateTime
  endsAt            DateTime
  createdByAdminId  String
  createdAt         DateTime @default(now())
}

// 관리자가 /이익추가로 수동으로 더한 매출. 실제 주문(Order)이 아닌 오프라인 판매 등을
// 통계(오늘/누적 매출)에 반영하기 위한 용도.
model ManualRevenueAdjustment {
  id               String   @id @default(cuid())
  amount           Int
  memo             String?
  createdByAdminId String
  createdAt        DateTime @default(now())
}

// 관리자가 /원가추가로 수동으로 더한 원가 (등급에 안 걸린 서버비/외주비 등).
// 등급별 원가(Tier.costPrice)와 합쳐서 관리자 대시보드의 순이익/적자를 계산한다.
model ManualCostAdjustment {
  id               String   @id @default(cuid())
  amount           Int
  memo             String?
  createdByAdminId String
  createdAt        DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  broadcast Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 서버 태그(디스코드 프로필의 "서버 태그" 배지) 착용자 대상 상품 자동 추첨 이벤트.
// 채널에 참가 버튼이 달린 안내 패널을 올려두고, 참가 시점에 신청자가 우리 서버 태그를
// 착용 중인지 확인한다. 마감은 관리자가 수동으로 하거나(closesAt 없음), 지정한 시각에
// 자동으로(closesAt 있음) 이뤄진다.
model RaffleEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  tierId      String
  tier        Tier     @relation(fields: [tierId], references: [id])
  channelId   String
  messageId   String?
  winnerCount Int      @default(1)
  status      String   @default("OPEN") // OPEN | DRAWN
  // 설정하면 이 시각에 자동으로 마감/추첨된다. null이면 관리자가 수동으로만 마감한다.
  closesAt    DateTime?
  closedAt    DateTime?

  createdByAdminId String
  createdAt         DateTime @default(now())

  entries RaffleEntry[]
  winners RaffleWinner[]
}

model RaffleEntry {
  id            String      @id @default(cuid())
  raffleId      String
  raffle        RaffleEvent @relation(fields: [raffleId], references: [id])
  discordUserId String
  discordTag    String
  enteredAt     DateTime    @default(now())

  @@unique([raffleId, discordUserId])
}

model RaffleWinner {
  id            String      @id @default(cuid())
  raffleId      String
  raffle        RaffleEvent @relation(fields: [raffleId], references: [id])
  discordUserId String
  discordTag    String
  // 실제 지급된 주문. 추첨 시점에 재고가 없어 지급에 실패하면 null로 남고 grantFailed가 true가 된다
  // (관리자가 /계정지급으로 나중에 수동 지급해야 함을 나타낸다).
  orderId       String?
  grantFailed   Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────
// 멀티테넌트 "자판기 판매" - 자비샵 자체를 구매해서 자기 이름으로 운영하게 판매한다.
// 각 샵은 완전히 분리된 SQLite 파일(dbPath)을 쓴다 - 기존 34개 테이블에 shopId를 전부
// 추가하는 대신, 프로세스는 하나(지금 이 jabishop-web/jabishop-bot)를 공유하되 요청마다
// (웹은 Host 헤더, 봇은 interaction.guildId 기준으로) src/lib/prisma.ts의 runWithTenant로
// 그 샵의 DB 파일만 바라보게 전환한다. 그래서 기존 코드 132개 파일 전부 수정할 필요가
// 없고, 자비샵 본인의 데이터/스키마도 전혀 건드리지 않는다 - 안전한 쪽을 택함.
// ─────────────────────────────────────────────────────────────

model Shop {
  id                String    @id @default(cuid())
  slug              String    @unique // 서브도메인: slug.krl.kr
  name              String
  dbPath            String    @unique // 이 샵 전용 SQLite 파일 절대경로
  port              Int?      @unique // 이 샵 전용 jabishop-web 프로세스가 듣는 포트
  discordGuildId    String?   @unique
  ownerUserId       String? // 자비샵(본인) 기준 User.id - 구독료를 여기서 포인트 차감
  // 구매한 사람의 디스코드 ID. 아직 discordGuildId가 비어있을 때(= 자기 서버에 봇을
  // 초대만 하고 아직 /샵연동을 안 한 상태) "이 사람이 맞게 연동하려는 게 맞는지" 확인하는 용도.
  claimDiscordId    String?
  status            String    @default("PROVISIONING") // PROVISIONING | ACTIVE | SUSPENDED | CANCELLED
  subscriptionPrice Int       @default(4000)
  nextBillingAt     DateTime?
  provisionError    String?
  // 이 샵 전용 웹사이트 로그인에 쓰는 디스코드 OAuth 앱 - 자비샵 것을 공유하지 않고,
  // 각 테넌트가 /샵봇설정으로 본인 디스코드 개발자 포털에서 만든 앱을 직접 등록한다.
  discordOAuthClientId     String?
  discordOAuthClientSecret String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// 특정 채널에서 새 메시지가 올라올 때마다 이전 게시물을 지우고 다시 올려서, 항상
// 채널 맨 아래(가장 최근)에 고정되어 있는 것처럼 보이게 하는 메시지.
model StickyMessage {
  id        String  @id @default(cuid())
  channelId String  @unique
  // CUSTOM(기본) = title/content/imageUrl/color로 만든 임베드를 고정.
  // ADMIN_PANEL = /관리자패널의 버튼 패널 자체를 고정 (내용은 매번 새로 만들어지므로 content는 안 쓴다).
  kind      String  @default("CUSTOM")
  title     String?
  content   String?
  imageUrl  String?
  color     Int?
  // 채널에 실제로 올라가 있는 가장 최근 복사본의 메시지 ID. 다음에 재게시할 때
  // 이 메시지를 먼저 지운다.
  messageId        String?
  createdByAdminId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 품절된 등급에 재입고 알림을 신청한 회원. 재고가 1개 이상 생기면 알림 보내고 구독을 지운다.
model RestockSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tierId    String
  tier      Tier     @relation(fields: [tierId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, tierId])
}

// ─────────────────────────────────────────────────────────────
// 판매자(제3자 입점) 마켓플레이스
// ─────────────────────────────────────────────────────────────

// 제3자 판매자(입점 신청자). 파트너(Partner)와는 별개 개념 - 파트너는 "홍보 교환"이고
// 판매자는 "서버 안에서 돈 받고 자기 상품을 파는" 유료 입점이다.
model Seller {
  id            String  @id @default(cuid())
  discordUserId String  @unique
  discordTag    String
  storeName     String
  category      String? // 🎮게임/💻디지털/🎨디자인/🤖봇/🖥️개발/📦기타 등 자유 텍스트
  saleMethod    String? // 판매 방식(예: 계좌이체, DM 거래 등) - 신청 시 입력
  description   String?
  // PENDING(승인대기) | ACTIVE(정상 운영) | SUSPENDED(관리자 정지) | EXPIRED(이용기간 만료) |
  // REJECTED(신청 거절) | WITHDRAWN(자진 탈퇴/퇴출)
  status        String  @default("PENDING")
  channelId     String? // 승인 시 판매자 카테고리 밑에 자동 생성된 쇼룸 채널 (구매자에게 보이는 공개 진열대)
  manageChannelId String? // 판매자 본인만 보이는 비공개 "관리 패널" 채널 (상품등록/통계/문의 버튼)

  // 이용기간 관리 - 결제는 포인트 자동차감이 아니라 관리자가 입금 확인 후 /판매자연장으로
  // 수동 연장한다 (사용자가 직접 결제하는 방식이 운영 쪽에서 더 관리하기 편하다는 판단).
  startedAt          DateTime?
  nextBillingAt      DateTime? // 이 시각 이후로는 만료 처리 대상
  lastReminderDays   Int? // 마지막으로 보낸 만료 예정 알림이 "며칠 전" 알림이었는지(7/3/1) - 중복 발송 방지
  expiredAt          DateTime?

  ratingSum   Int @default(0)
  ratingCount Int @default(0)
  dealCount   Int @default(0) // 거래완료로 종료된 티켓 수

  adminNote          String?
  processedByAdminId String?
  processedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products SellerProduct[]
  tickets  SellerTicket[]
  reviews  SellerReview[]
  reports  SellerReport[]
}

model SellerProduct {
  id             String   @id @default(cuid())
  sellerId       String
  seller         Seller   @relation(fields: [sellerId], references: [id])
  name           String
  price          Int
  stock          Int? // null = 재고 표시 안 함(무제한/별도 문의)
  description    String?
  purchaseMethod String?
  refundPolicy   String?
  channelId      String? // 올라간 채널(보통 판매자 쇼룸 채널과 동일)
  messageId      String? // 상품 임베드 메시지 id - 재게시/수정 시 참조
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  tickets SellerTicket[]
}

// 구매 문의(비공개 티켓). 채널 하나 = 티켓 하나.
model SellerTicket {
  id             String         @id @default(cuid())
  sellerId       String
  seller         Seller         @relation(fields: [sellerId], references: [id])
  productId      String?
  product        SellerProduct? @relation(fields: [productId], references: [id])
  buyerDiscordId String
  buyerTag       String
  channelId      String?
  // OPEN(문의중) | PAID(결제완료) | DELIVERED(상품전달) | COMPLETED(거래완료) |
  // CANCELLED(구매자취소) | CLOSED(그냥닫음)
  status    String    @default("OPEN")
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  review SellerReview?
}

model SellerReview {
  id             String   @id @default(cuid())
  sellerId       String
  seller         Seller   @relation(fields: [sellerId], references: [id])
  ticketId       String   @unique
  ticket         SellerTicket @relation(fields: [ticketId], references: [id])
  buyerDiscordId String
  rating         Int // 1~5
  content        String?
  createdAt      DateTime @default(now())
}

model SellerReport {
  id                String    @id @default(cuid())
  sellerId          String
  seller            Seller    @relation(fields: [sellerId], references: [id])
  reporterDiscordId String
  reason            String // 사기/상품 미제공/허위 상품/가격 문제/욕설·비매너/규정 위반/기타
  detail            String?
  status            String    @default("PENDING") // PENDING | RESOLVED
  action            String? // WARNING | SUSPEND | EXPEL
  processedByAdminId String?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
}

// 안티스팸이 적발한 위반 1건 = 1행. 실시간 판단(도배 횟수 등)은 메모리에서 하고, 여기엔
// 통계/이력/제재 해제용으로 결과만 남긴다. 같은 유저의 최근 24시간 내 건수로 제재 단계를
// 올린다 (src/bot/antiSpam.ts의 ESCALATION_TIERS).
model SpamViolation {
  id              String    @id @default(cuid())
  guildId         String
  discordUserId   String
  discordTag      String
  channelId       String
  violationType   String // FLOOD | DUPLICATE | REPEAT_CHAR | CROSS_CHANNEL | MENTION_BOMB | EMOJI_SPAM | INVITE_LINK | ATTACHMENT_FLOOD
  messageExcerpt  String // 신고/감사용으로 남기는 메시지 내용 일부(최대 300자)
  actionTaken     String // DELETE_ONLY | TIMEOUT
  timeoutSeconds  Int?
  lifted          Boolean   @default(false) // 관리자가 오탐으로 판단해 제재를 해제했는지
  liftedByAdminId String?
  liftedAt        DateTime?
  createdAt       DateTime  @default(now())

  @@index([guildId, discordUserId, createdAt])
}
